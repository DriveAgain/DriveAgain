      m_Calls: []
  m_text: "\n\n\u05DE\u05D8\u05E8\u05EA \u05D4\u05DE\u05E9\u05D7\u05E7 \u05D4\u05D9\u05D0
    \u05DC\u05EA\u05E8\u05D2\u05DC \u05E0\u05D4\u05D9\u05D2\u05D4 \u05D1\u05E1\u05D9\u05E1\u05D9\u05EA
    \u05D1\u05E1\u05D1\u05D9\u05D1\u05D4 \u05D1\u05D8\u05D5\u05D7\u05D4.\r\n\r\n\u05D1\u05DE\u05E9\u05D7\u05E7
    \u05D9\u05E9 3 \u05DB\u05D5\u05DB\u05D1\u05D9\u05DD.\r\n\u05DB\u05DC \u05DB\u05D5\u05DB\u05D1
    \u05E9\u05D5\u05D5\u05D4 001 \u05E0\u05E7\u05D5\u05D3\u05D5\u05EA.\r\n\r\n\u05DE\u05D0\u05D1\u05D3\u05D9\u05DD
    \u05DB\u05D5\u05DB\u05D1 \u05DB\u05D0\u05E9\u05E8:\r\n- \u05DC\u05D0 \u05E2\u05D5\u05E6\u05E8\u05D9\u05DD
    \u05D1\u05EA\u05DE\u05E8\u05D5\u05E8 \u05E2\u05E6\u05D5\u05E8\r\n- \u05E0\u05D5\u05E1\u05E2\u05D9\u05DD
    \u05D1\u05DE\u05D4\u05D9\u05E8\u05D5\u05EA \u05D2\u05D1\u05D5\u05D4\u05D4 \u05DE\u05D3\u05D9\r\n-
    \u05D9\u05D5\u05E8\u05D3\u05D9\u05DD \u05DE\u05D4\u05DB\u05D1\u05D9\u05E9 \u05D0\u05D5
    \u05D8\u05D5\u05E2\u05D9\u05DD \u05D1\u05DE\u05E1\u05DC\u05D5\u05DC\r\n\r\n\u05DB\u05D0\u05E9\u05E8
    \u05DB\u05DC \u05D4\u05DB\u05D5\u05DB\u05D1\u05D9\u05DD \u05E0\u05D2\u05DE\u05E8\u05D9\u05DD
    \u2013 \u05D4\u05DE\u05E9\u05D7\u05E7 \u05E0\u05E4\u05E1\u05DC.\r\n\r\n\u05D4\u05DE\u05E9\u05D7\u05E7
    \u05E0\u05D5\u05E2\u05D3 \u05DC\u05D3\u05DE\u05D5\u05EA \u05DE\u05E6\u05D1\u05D9
    \u05E0\u05D4\u05D9\u05D2\u05D4 \u05E4\u05E9\u05D5\u05D8\u05D9\u05DD \u05DB\u05D3\u05D9
    \u05DC\u05E2\u05D6\u05D5\u05E8 \u05DC\u05D0\u05E0\u05E9\u05D9\u05DD \u05E2\u05DD
    \u05E4\u05D2\u05D9\u05E2\u05EA \u05E8\u05D0\u05E9\r\n\u05DC\u05E9\u05E4\u05E8
    \u05E7\u05E9\u05D1, \u05D6\u05DE\u05DF \u05EA\u05D2\u05D5\u05D1\u05D4 \u05D5\u05E7\u05D1\u05DC\u05EA
    \u05D4\u05D7\u05DC\u05D8\u05D5\u05EA.\r\n"
